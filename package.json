{
  "name": "wirdi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start --filter=@wirdi/backend --filter=@wirdi/client",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @wirdi/backend test:e2e",
    "db:seed": "pnpm --filter @wirdi/backend db:seed",
    "db:reset:test": "pnpm --filter @wirdi/backend db:reset:test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.10",
    "turbo": "^2.4.4"
  }
}
